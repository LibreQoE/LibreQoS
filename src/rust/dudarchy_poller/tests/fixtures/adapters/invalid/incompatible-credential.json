{
  "schema_version": 2,
  "id": "incompatible-credential",
  "detect": { "sys_descr_contains": ["X"] },
  "surfaces": [{ "id": "api", "transport": "routeros_api", "credential_ref": "snmp" }],
  "probes": [{ "id": "identity", "surface": "api", "read": { "kind": "command", "command": { "name": "system_identity", "fields": [{ "name": "name", "from": "name" }] } } }]
}
