{
  "schema_version": 2,
  "id": "default-with-hints",
  "detect": {
    "default": true,
    "sys_descr_contains": ["ExampleOS"]
  },
  "surfaces": [
    { "id": "snmp", "transport": "snmp_v2c", "credential_ref": "snmp" }
  ],
  "probes": [
    {
      "id": "system",
      "surface": "snmp",
      "read": {
        "kind": "scalars",
        "scalars": [
          { "name": "sys_name", "oid": "1.3.6.1.2.1.1.5.0", "parser": "utf8" }
        ]
      }
    }
  ]
}
