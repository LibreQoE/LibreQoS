{
  "schema_version": 2,
  "id": "swos-switch",
  "detect": {
    "sys_object_id_prefixes": ["1.3.6.1.4.1.14988.2"],
    "sys_descr_contains": ["SwOS"]
  },
  "surfaces": [
    { "id": "snmp", "transport": "snmp_v2c", "credential_ref": "snmp" }
  ],
  "probes": [
    {
      "id": "if_table",
      "surface": "snmp",
      "read": {
        "kind": "table",
        "table": {
          "columns": [
            { "name": "name", "oid": "1.3.6.1.2.1.31.1.1.1.1", "parser": "utf8" },
            { "name": "raw_type", "oid": "1.3.6.1.2.1.2.2.1.3", "parser": "u32" },
            { "name": "oper_state", "oid": "1.3.6.1.2.1.2.2.1.8", "parser": "u32" }
          ],
          "index": { "kind": "single" }
        }
      }
    },
    {
      "id": "fdb",
      "surface": "snmp",
      "read": {
        "kind": "table",
        "table": {
          "columns": [
            { "name": "mac", "oid": "1.3.6.1.2.1.17.4.3.1.1", "parser": "octet_mac" },
            { "name": "port", "oid": "1.3.6.1.2.1.17.4.3.1.2", "parser": "u32" },
            { "name": "status", "oid": "1.3.6.1.2.1.17.4.3.1.3", "parser": "u32" }
          ],
          "index": { "kind": "dot1d_mac" },
          "bridge_port_resolution": "identity"
        }
      }
    }
  ],
  "maps": {
    "details": {
      "interfaces": "if_table"
    },
    "residuals": [
      {
        "name": "qbridge-absent",
        "source": "host/tests/fixtures/switch-fdb/README.md: SwOS answers NoSuchObject for Q-BRIDGE"
      }
    ]
  },
  "budget": {
    "max_rows": 1024
  }
}
