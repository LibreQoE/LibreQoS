{
  "schema_version": 2,
  "id": "edgeos",
  "detect": {
    "sys_object_id_prefixes": ["1.3.6.1.4.1.41112.1.5"],
    "sys_descr_contains": ["EdgeOS"]
  },
  "surfaces": [
    { "id": "snmp", "transport": "snmp_v2c", "credential_ref": "snmp" }
  ],
  "probes": [
    {
      "id": "system",
      "surface": "snmp",
      "read": {
        "kind": "scalars",
        "scalars": [
          { "name": "sys_descr", "oid": "1.3.6.1.2.1.1.1.0", "parser": "utf8" },
          { "name": "sys_name", "oid": "1.3.6.1.2.1.1.5.0", "parser": "utf8" },
          { "name": "sys_object_id", "oid": "1.3.6.1.2.1.1.2.0", "parser": "oid" }
        ]
      }
    },
    {
      "id": "if_table",
      "surface": "snmp",
      "on_absent": "optional",
      "read": {
        "kind": "table",
        "table": {
          "columns": [
            { "name": "description", "oid": "1.3.6.1.2.1.2.2.1.2", "parser": "utf8" },
            { "name": "raw_type", "oid": "1.3.6.1.2.1.2.2.1.3", "parser": "u32" },
            { "name": "mac", "oid": "1.3.6.1.2.1.2.2.1.6", "parser": "octet_mac" },
            { "name": "admin_state", "oid": "1.3.6.1.2.1.2.2.1.7", "parser": "u32" },
            { "name": "oper_state", "oid": "1.3.6.1.2.1.2.2.1.8", "parser": "u32" },
            { "name": "name", "oid": "1.3.6.1.2.1.31.1.1.1.1", "parser": "utf8" },
            { "name": "alias", "oid": "1.3.6.1.2.1.31.1.1.1.18", "parser": "utf8" }
          ],
          "index": { "kind": "single" }
        }
      }
    },
    {
      "id": "ip_addresses",
      "surface": "snmp",
      "on_absent": "optional",
      "read": {
        "kind": "table",
        "table": {
          "columns": [
            { "name": "if_index", "oid": "1.3.6.1.2.1.4.20.1.2", "parser": "u32" },
            { "name": "netmask", "oid": "1.3.6.1.2.1.4.20.1.3", "parser": "ip_address" }
          ],
          "index": { "kind": "ip_address_v4" }
        }
      }
    },
    {
      "id": "lldp",
      "surface": "snmp",
      "on_absent": "optional",
      "read": {
        "kind": "table",
        "table": {
          "columns": [
            { "name": "local_port", "oid": "1.0.8802.1.1.2.1.4.1.1.2", "parser": "u32" },
            { "name": "chassis_id", "oid": "1.0.8802.1.1.2.1.4.1.1.5", "parser": "octet_mac" },
            { "name": "port_id", "oid": "1.0.8802.1.1.2.1.4.1.1.7", "parser": "utf8" },
            { "name": "sys_name", "oid": "1.0.8802.1.1.2.1.4.1.1.9", "parser": "utf8" },
            { "name": "sys_descr", "oid": "1.0.8802.1.1.2.1.4.1.1.10", "parser": "utf8" }
          ],
          "index": { "kind": "lldp_rem" }
        }
      }
    },
    {
      "id": "arp_media",
      "surface": "snmp",
      "on_absent": "optional",
      "read": {
        "kind": "table",
        "table": {
          "columns": [
            { "name": "mac", "oid": "1.3.6.1.2.1.4.22.1.2", "parser": "octet_mac" }
          ],
          "index": { "kind": "arp_v4" }
        }
      }
    },
    {
      "id": "arp_physical",
      "surface": "snmp",
      "on_absent": "optional",
      "read": {
        "kind": "table",
        "table": {
          "columns": [
            { "name": "mac", "oid": "1.3.6.1.2.1.4.35.1.4", "parser": "octet_mac" }
          ],
          "index": { "kind": "arp_typed" }
        }
      }
    }
  ],
  "maps": {
    "claims": [
      { "kind": "name", "fields": ["system.sys_name", "lldp.sys_name"] },
      { "kind": "sysdescr", "fields": ["system.sys_descr", "lldp.sys_descr"] },
      { "kind": "portid", "fields": ["lldp.port_id"] },
      { "kind": "localport", "fields": ["lldp.local_port"] }
    ],
    "details": {
      "interfaces": "if_table",
      "arp": "arp_media"
    },
    "residuals": [
      {
        "name": "lldp-unavailable",
        "source": "docs/recon/edgeos.md: every LLDP table answers NoSuchObject; the optional feed is expected absent, and adjacency comes from this router's neighbours"
      },
      {
        "name": "fdb-unavailable",
        "source": "docs/recon/edgeos.md: an L3 router answers no forwarding database, so no FDB probe is declared"
      },
      {
        "name": "ipv6-addresses-unread",
        "source": "docs/recon/edgeos.md: ipAddressTable carries the router's IPv6 addresses; schema v2 reads only the IPv4 ipAddrTable"
      },
      {
        "name": "lag-membership-unread",
        "source": "docs/recon/edgeos.md: IEEE8023-LAG-MIB dot3adAggTable/dot3adAggPortTable answer NoSuchObject, ifStackTable has only 0 rows, and ifTable has no bond/aggregate interface, so LACP membership is configuration-only and not observable over SNMP"
      }
    ]
  }
}
