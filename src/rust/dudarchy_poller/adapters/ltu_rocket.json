{
  "schema_version": 2,
  "id": "ltu_rocket",
  "detect": {
    "sys_object_id_prefixes": ["1.3.6.1.4.1.41112.1.10"]
  },
  "surfaces": [
    { "id": "snmp", "transport": "snmp_v2c", "credential_ref": "snmp" }
  ],
  "probes": [
    {
      "id": "identity",
      "surface": "snmp",
      "on_absent": "optional",
      "read": {
        "kind": "scalars",
        "scalars": [
          { "name": "model", "oid": "1.3.6.1.4.1.41112.1.10.1.3.2.0", "parser": "utf8" },
          { "name": "name", "oid": "1.3.6.1.4.1.41112.1.10.1.3.3.0", "parser": "utf8" },
          { "name": "channel_width_mhz", "oid": "1.3.6.1.4.1.41112.1.10.1.2.4.0", "parser": "u32" }
        ]
      }
    },
    {
      "id": "stations",
      "surface": "snmp",
      "on_absent": "optional",
      "read": {
        "kind": "table",
        "table": {
          "columns": [
            { "name": "mac", "oid": "1.3.6.1.4.1.41112.1.10.1.4.1.11", "parser": "octet_mac" },
            { "name": "ip", "oid": "1.3.6.1.4.1.41112.1.10.1.4.1.25", "parser": "ip_address" },
            { "name": "hostname", "oid": "1.3.6.1.4.1.41112.1.10.1.4.1.13", "parser": "utf8" },
            { "name": "tx_capacity", "oid": "1.3.6.1.4.1.41112.1.10.1.4.1.4", "parser": "u32" },
            { "name": "rx_capacity", "oid": "1.3.6.1.4.1.41112.1.10.1.4.1.3", "parser": "u32" },
            { "name": "dl_rate_mbps", "oid": "1.3.6.1.4.1.41112.1.10.1.4.1.4", "parser": "kbps_to_mbps" },
            { "name": "model", "oid": "1.3.6.1.4.1.41112.1.10.1.4.1.12", "parser": "utf8" }
          ],
          "index": { "kind": "station_mac" }
        }
      }
    }
  ],
  "maps": {
    "claims": [
      { "kind": "name", "fields": ["identity.name"] }
    ],
    "details": {
      "stations": "stations",
      "radio": "identity"
    }
  },
  "budget": {
    "max_requests": 64,
    "max_rows": 256,
    "max_bytes": 65536,
    "deadline_ms": 8000
  }
}
