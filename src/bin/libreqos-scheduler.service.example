[Unit]
Description=LibreQoS scheduler (the integration hub)
Wants=network-online.target
After=network-online.target systemd-resolved.service libreqos-lqosd.service
# Q4: the scheduler's bus peer is lqosd; the bridge relationship is
# lqosd's concern. The scheduler runs in BOTH postures.
Requires=libreqos-lqosd.service

[Service]
WorkingDirectory=/opt/libreqos/src
ExecStartPre=/bin/test -x /opt/libreqos/venv/bin/python
ExecStartPre=/opt/libreqos/venv/bin/python -c "import apscheduler, chardet, deepdiff, psutil, requests"
ExecStart=/opt/libreqos/venv/bin/python /opt/libreqos/src/scheduler.py
Restart=always

[Install]
WantedBy=multi-user.target
